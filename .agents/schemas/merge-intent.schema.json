{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "pull_request",
    "head_sha",
    "actor",
    "authorized_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "merge-intent" },
    "pull_request": { "type": "integer", "minimum": 1 },
    "head_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "actor": { "type": "string", "minLength": 1 },
    "authorized_at": { "type": "string", "format": "date-time" }
  }
}
