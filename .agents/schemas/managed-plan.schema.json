{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "base_sha",
    "snapshot_sha256",
    "policy_sha256",
    "triage_sha256",
    "task",
    "selected_skills",
    "claims",
    "allowed_paths",
    "forbidden_paths",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "managed-plan" },
    "run_id": { "$ref": "#/$defs/nonEmpty" },
    "base_sha": { "$ref": "#/$defs/gitSha" },
    "snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "triage_sha256": { "$ref": "#/$defs/sha256" },
    "task": { "$ref": "#/$defs/nonEmpty" },
    "selected_skills": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "behavior",
          "production_seam",
          "test",
          "negative_cases"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^CLAIM-[A-Z0-9-]+$" },
          "behavior": { "$ref": "#/$defs/nonEmpty" },
          "production_seam": { "$ref": "#/$defs/nonEmpty" },
          "test": { "$ref": "#/$defs/nonEmpty" },
          "negative_cases": { "$ref": "#/$defs/nonEmptyStrings" }
        }
      }
    },
    "allowed_paths": { "$ref": "#/$defs/nonEmptyStrings" },
    "forbidden_paths": { "$ref": "#/$defs/nonEmptyStrings" },
    "verification": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    }
  }
}
