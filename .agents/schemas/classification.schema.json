{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "base_sha",
    "head_sha",
    "policy_sha256",
    "type",
    "changes",
    "paths",
    "areas",
    "risk",
    "skills",
    "checks",
    "human_review_required",
    "automerge_eligible",
    "generated_paths",
    "matched_rules",
    "labels"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "change-classification" },
    "base_sha": { "$ref": "#/$defs/gitSha" },
    "head_sha": { "$ref": "#/$defs/gitSha" },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "type": { "type": "string", "minLength": 1 },
    "changes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/change" }
    },
    "paths": { "$ref": "#/$defs/nonEmptyPaths" },
    "areas": { "$ref": "#/$defs/nonEmptyStrings" },
    "risk": { "enum": ["low", "medium", "high", "human-required"] },
    "skills": { "$ref": "#/$defs/nonEmptyStrings" },
    "checks": { "$ref": "#/$defs/nonEmptyStrings" },
    "human_review_required": { "type": "boolean" },
    "automerge_eligible": { "type": "boolean" },
    "generated_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repoPath" }
    },
    "matched_rules": { "$ref": "#/$defs/nonEmptyStrings" },
    "labels": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repoPath" }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path"],
      "properties": {
        "status": { "enum": ["added", "modified", "deleted", "renamed"] },
        "path": { "$ref": "#/$defs/repoPath" },
        "previous_path": { "$ref": "#/$defs/repoPath" },
        "binary": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "renamed" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "previous_path": { "$ref": "#/$defs/repoPath" } },
            "required": ["previous_path"]
          },
          "else": { "properties": { "previous_path": false } }
        }
      ]
    }
  }
}
