{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "grant_scope",
    "authorization_nonce",
    "issued_at",
    "expires_at",
    "repository",
    "pull_request",
    "artifact_manifest_sha256",
    "policy_sha256",
    "credential_token_sha256",
    "credential_mode",
    "local_change_base_sha",
    "planning_head_sha",
    "candidate_head_sha",
    "expected_old_candidate_sha",
    "candidate_ref",
    "target_base_ref",
    "expected_target_base_sha",
    "pr_state",
    "pr_base_ref_name",
    "pr_base_ref_oid",
    "pr_head_ref_name",
    "pr_head_ref_oid",
    "same_repository",
    "principal"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "publication-authorization" },
    "grant_scope": { "const": "initial-candidate-publication" },
    "authorization_nonce": { "$ref": "#/$defs/sha256" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "repository": { "const": "davidomil/cloudx" },
    "pull_request": { "const": 1 },
    "artifact_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "credential_token_sha256": { "$ref": "#/$defs/sha256" },
    "credential_mode": {
      "const": "attended-user"
    },
    "local_change_base_sha": { "$ref": "#/$defs/gitSha" },
    "planning_head_sha": { "$ref": "#/$defs/gitSha" },
    "candidate_head_sha": { "$ref": "#/$defs/gitSha" },
    "expected_old_candidate_sha": { "$ref": "#/$defs/gitSha" },
    "candidate_ref": { "const": "refs/heads/architecture-and-new-codex" },
    "target_base_ref": { "const": "refs/heads/main" },
    "expected_target_base_sha": { "$ref": "#/$defs/gitSha" },
    "pr_state": { "const": "OPEN" },
    "pr_base_ref_name": { "const": "main" },
    "pr_base_ref_oid": { "$ref": "#/$defs/gitSha" },
    "pr_head_ref_name": { "const": "architecture-and-new-codex" },
    "pr_head_ref_oid": { "$ref": "#/$defs/gitSha" },
    "same_repository": { "const": true },
    "principal": { "$ref": "#/$defs/attendedUserPrincipal" }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "login": {
      "type": "string",
      "minLength": 1,
      "maxLength": 39,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?$"
    },
    "attendedUserPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "user_id", "login", "attended_authorization_id"],
      "properties": {
        "kind": { "const": "github-user" },
        "user_id": { "type": "integer", "minimum": 1 },
        "login": { "$ref": "#/$defs/login" },
        "attended_authorization_id": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
