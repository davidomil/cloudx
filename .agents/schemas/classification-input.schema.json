{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "base_sha",
    "head_sha",
    "type",
    "changes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "change-classification-input" },
    "base_sha": { "$ref": "#/$defs/gitSha" },
    "head_sha": { "$ref": "#/$defs/gitSha" },
    "type": { "type": "string", "minLength": 1 },
    "changes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/change" }
    },
    "risk": { "type": "string" },
    "labels": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path"],
      "properties": {
        "status": { "enum": ["added", "modified", "deleted", "renamed"] },
        "path": { "type": "string", "minLength": 1 },
        "previous_path": { "type": "string", "minLength": 1 },
        "binary": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "renamed" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "previous_path": { "type": "string", "minLength": 1 }
            },
            "required": ["previous_path"]
          },
          "else": { "properties": { "previous_path": false } }
        }
      ]
    }
  }
}
